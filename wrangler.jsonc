{
  "name": "shumeinfc-projects",
  "main": "worker.js",
  "compatibility_date": "2025-08-03",
  "assets": {
    "directory": "."
  },
  "vars": {
    "FEISHU_APP_ID": "cli_aaefa41a0c389bd9",
    "FEISHU_APP_TOKEN": "YUZ4wB3YJiLTq2kUobZccYOKnBb",
    "FEISHU_TABLE_ID": "tblepAz1PHnzwxA2"
  },
  "routes": [
    { "pattern": "nfc.raspjam.com", "zone_name": "raspjam.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "SHUMEI_KV", "id": "f923c5988e4a4cbdbbceb0c4b35028e8" }
  ],
  // 位置雷达在线状态存储。首次部署前请在 Cloudflare 控制台创建 D1 数据库，
  // 并把下方 database_id 替换为真实值；建库后由管理台「位置地图」页面自动初始化表。
  "d1_databases": [
    { "binding": "PRESENCE_DB", "database_name": "shumei-presence", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "triggers": {
    "crons": ["30 * * * *"]
  }
}

